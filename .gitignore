# API Keys - DO NOT COMMIT
.api_keys
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv

# Coverage measurement artifacts. The shields badge payload
# (assets/data/coverage.json) IS tracked — it is what the README renders.
.coverage
.coverage.*
/coverage-report.json
htmlcov/

# Data cache / temp
data_cache/
*.cache
# integrity_report.json — preflight_integrity.check() returns the dict in-memory
# (brief_preflight uses the return value); the written file has no reader and rots.
assets/data/integrity_report.json
*.log
media/

# Images / generated output
# site/assets/ is the one place shipped visuals live (README / OG card / Pages all point
# there). Everything else is scratch. These negations matter: without them the
# shipped PNGs survive only by already being tracked, so a single `git rm --cached`
# would make them unaddable.
*.png
!site/assets/*.png
!site/assets/icons/*.png
*.jpg
!docs/*.png
!docs/*.jpg
!docs/**/*.png
!docs/**/*.jpg
*.jpeg
*.gif
*.mp4
# README/social artifacts (refreshed weekly by screenshot-refresh.yml) — allow these
!site/assets/social-card.png
!site/assets/dashboard.gif
# per-tab frames are transient inputs to assemble_dashboard_gif.py — never commit
.gifframes/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OpenClaw internal
.openclaw/
.clawhub/

# Misc temp
haizhi_02706_data.json
monitor_state.json
SESSION_HANDOFF.md
streaming_notes.md
streaming_config_guide.md
setup_openclaw_web.sh
fix_stock_analyzer.py

# Runtime state files (cron / heartbeat output, not source data)
memory/heartbeat-state.json
memory/.tmp/cron-heartbeats.json
memory/.tmp/workflow-outcomes.json
memory/.tmp/workflow-outcomes.lock
memory/last_hk_monitoring.json
# openclaw bootstrap/setup state — machine-local runtime artifact, never source
openclaw-workspace-state.json
# cron logs (local-only)
logs/*
# dashboard build status must reach the GHA cron-health runner (its only reader)
!logs/dashboard_build_status.json

# Preflight transient context (regenerated every brief run)
memory/.tmp/
memory/.tmp-*

# OpenClaw memory system internals (not for public consumption)
memory/.dreams/
memory/dreaming/

# Promoted chat-session transcripts (`memory/YYYY-MM-DD-HHMM.md`). OpenClaw writes
# them for its own memory search, which reads the working tree — so they stay on
# the host and out of git. Forty of them were tracked into a public repository
# carrying WeChat/Telegram session keys, and nothing in the codebase ever read
# one: every reader globs `*-plan.json`, `*-pre-open.md`, or the dated
# `memory/YYYY-MM-DD.md` day log, none of which match this shape.
memory/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9].md

# Daily notes (`memory/YYYY-MM-DD.md`) — untracked as of #1038. Same reasoning
# as the transcripts above: they are workspace continuity (AGENTS.md "Every
# Session" reads today+yesterday from disk), not repository data. Zero
# repo-level consumers: stage_site globs only *-pre-open.md, no code/workflow/
# test reads a bare-dated diary, and the openclaw memory index rglobs the
# working tree, so untracking loses nothing anywhere. The existing 37 were
# removed from the index with their content kept on disk; new days are born
# ignored. Writers that sweep `git add memory/` skip these silently.
memory/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md

# One-off dated prose, untracked 2026-08-26 (#1038 follow-up): personal
# workspace notes (travel, OAuth/larkbot setup, one-day policy memos) with zero
# repo-level consumers — verified per file by grep across src/ops/site/tests/
# docs before untracking. Listed by exact name because no glob separates them
# from briefs that must stay tracked, and an ignore rule is what keeps the
# postflight's directory-scoped `git add memory/` from re-tracking them.
# Disk copies stay; git history preserves the public past. The two strategy
# ruling source docs (2026-06-23-2225-spch-infinite-ammo.md,
# analysis-2026-08-15-add-gap.md) deliberately remain tracked.
memory/2026-04-05-skills-policy.md
memory/2026-04-06-tools-access.md
memory/2026-04-07-hk-storage.md
memory/2026-04-07-larkbot-lock.md
memory/2026-04-07-oauth-plan.md
memory/2026-04-07-startup-greeting.md
memory/2026-04-08-skills-policy.md
memory/2026-04-12-trading-strategy.md
memory/2026-04-14-leveraged-etf.md
memory/2026-04-15-portfolio-review.md
memory/2026-04-15-skillhub-policy.md
memory/2026-04-15-trade-correction.md
memory/2026-04-20-airport-lounge.md
memory/2026-04-21-hongkong-defensive.md
memory/2026-04-21-hotel-map.md
memory/2026-06-07-rklb-serenity-research.md

# Misc
share/

# Playwright lib for local GIF recording (refresh_dashboard_gif.sh) — never commit
node_modules/
# `npm pack` in examples/dsh/packages/clawock-dsh leaves the tarball beside the
# package; the live installer packs into a temp dir, so a tarball here is always
# a local by-product and never something to commit.
*.tgz

# safe_io 写盘产物（flock 锁 + 备份），不入库
portfolio.json.lock
portfolio.json.bak
*.json.lock
*.json.bak

# root-level scratch (cron report drafts) — never commit
/.tmp/

# Build metadata — generated by pip/setuptools, never committed. Anchored to the
# repository root: unanchored, `build/` also matches `scripts/build/`, so every
# NEW file added there was silently ignored while the two that predate the rule
# stayed tracked — `git add -A` reported nothing and the file simply was not in
# the commit.
*.egg-info/
/build/
/dist/

# Dashboard build outputs — published to the `data-plane` branch, not committed
# (#314). Still written into the worktree by every build; ignored so no committer
# can put a generation back into repository history by accident, and so
# `git status` stays quiet on a machine that builds them. 71% of the commits on
# master were these four files.
/assets/data/overview.json
/assets/data/dashboard.json
/assets/data/decision_audit.json
/assets/data/shadow_portfolio.json
# Written by the same tick as the four above and published with them (#325).
# They were the publisher's entire commit pathspec, which is why moving only the
# four barely changed the commit count.
/assets/data/cron-heartbeats.json
/assets/data/workflow-outcomes.json
# The last published generation, materialised for `--previous` and for the
# semantic diff's baseline.
/.data-plane.cache/
