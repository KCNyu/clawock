{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KCNyu/clawock/src/clawock/config/instruments.schema.json",
  "title": "clawock canonical instrument registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instruments"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "instruments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/instrument"
      }
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "region",
        "currency",
        "venue",
        "venue_suffix",
        "tencent_symbol",
        "eastmoney_secid",
        "sector",
        "themes",
        "factor",
        "leverage_multiple",
        "underlying",
        "one_x_substitute",
        "signal_symbol",
        "listing_date",
        "peer_bucket",
        "retired"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "region": {"enum": ["US", "HK"]},
        "currency": {"enum": ["USD", "HKD"]},
        "venue": {"type": "string", "minLength": 1},
        "venue_suffix": {"type": ["string", "null"]},
        "tencent_symbol": {"type": ["string", "null"]},
        "eastmoney_secid": {"type": ["string", "null"]},
        "sector": {"type": "string", "minLength": 1},
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "factor": {"type": "string", "minLength": 1},
        "leverage_multiple": {"type": "number", "minimum": 1},
        "underlying": {"type": ["string", "null"]},
        "one_x_substitute": {"type": ["string", "null"]},
        "signal_symbol": {"type": ["string", "null"]},
        "listing_date": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          ]
        },
        "peer_bucket": {"type": "string", "minLength": 1},
        "retired": {"type": "boolean"}
      }
    }
  }
}
