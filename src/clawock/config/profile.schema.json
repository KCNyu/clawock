{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clawock:schema:profile:1",
  "title": "clawock runtime and decision profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "locale", "timezone", "markets",
    "workflows", "resources", "policies", "templates", "delivery"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "locale": {"type": "string", "minLength": 2},
    "timezone": {"type": "string", "minLength": 1},
    "markets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timezone", "label", "analysis_command"],
        "properties": {
          "timezone": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "analysis_command": {"type": "string", "minLength": 1},
          "skill": {"type": ["string", "null"]}
        }
      }
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "markets"],
        "properties": {
          "enabled": {"type": "boolean"},
          "markets": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "policy": {"type": ["string", "null"]},
          "template": {"type": ["string", "null"]}
        }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "policies": {"type": "object"},
    "templates": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "targets"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": {"enum": ["runtime_job", "environment", "disabled"]},
              "key": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
