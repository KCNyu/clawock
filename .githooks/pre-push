#!/usr/bin/env bash
# clawock pre-push hook — runs scripts/system_check.py before allowing any push.
# Critical failure blocks push; warnings shown but push proceeds.
#
# Override with: git push --no-verify  (use sparingly)

set -e
WS="$(git rev-parse --show-toplevel)"

if [ ! -f "$WS/scripts/system_check.py" ]; then
  # No checker yet — let push through
  exit 0
fi

echo "▸ running clawock system_check.py before push…"
# NOTE: `set -e` above means a non-zero exit here would abort the hook BEFORE we
# inspect RC — which is exactly what we must NOT do for RC=2 (warnings, allow).
# So capture the rc without letting set -e kill us. (2026-06-05: a 6.1 SQLite
# migration warning — cron jobs.json moved → system_check returns 2 — was
# silently turning every push into "failed to push some refs".)
RC=0
python3 "$WS/scripts/system_check.py" || RC=$?

if [ "$RC" = "1" ]; then
  echo
  echo "🚫 push blocked by clawock system_check (critical failures above)"
  echo "   fix the issue, OR override with: git push --no-verify"
  exit 1
fi

# ── Money-conservation gate (2026-07-04) ─────────────────────────────────────
# preflight_integrity's ERROR class = arithmetic identities that MUST hold:
# TCV==Σcurrent_value, total_pnl==TCV−cost, cash==baseline+Σtrades+adj (CASH_RECON),
# cost_basis==moving-weighted (COST_BASIS), FX currency tags. These fire exactly
# when someone edited portfolio.json (a T+0 sell, an abshou buy) and FORGOT to
# reconcile — the "$581 double-count" / "phantom-peak TCV" class of bug. Turning
# the human "改完必跑 recompute" 铁律 into a structural block: never publish an
# unreconciled book. WARN (staleness etc.) does NOT block. Override: --no-verify.
IRC=0
python3 "$WS/scripts/data/preflight_integrity.py" >/tmp/clawock_integrity.out 2>&1 || IRC=$?
if [ "$IRC" = "2" ]; then
  echo
  echo "🚫 push blocked — portfolio.json fails a money-conservation check:"
  grep -E 'ERROR|❌|🔴' /tmp/clawock_integrity.out | head -12
  echo "   run:  bash scripts/data/reconcile.sh   (recompute cash + realized, re-check)"
  echo "   then re-commit portfolio.json. Override (rare): git push --no-verify"
  exit 1
fi

# RC=0 (all OK) or RC=2 (warnings) — allow push
exit 0
