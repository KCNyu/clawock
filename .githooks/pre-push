#!/usr/bin/env bash
# clawock pre-push hook — protects updates to master.
# Critical failure blocks a master push; warnings shown but push proceeds.
#
# Override with: git push --no-verify  (use sparingly)

set -e
WS="$(git rev-parse --show-toplevel)"

# Git passes one line per ref update on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# The checks below certify the live ledger/workspace that backs `master`. They
# say nothing about an orphan artifact ref, and running them there creates the
# opposite of isolation: on 2026-08-08 an in-flight SPCH ledger edit blocked
# every force-update of `data-plane`, freezing the public dashboard although
# the generation being pushed contained no portfolio.json at all (#370).
#
# Keep an empty stdin fail-closed for direct/manual hook probes. During a real
# push Git always supplies the update lines; when it supplies lines and none
# targets master, this hook has no applicable invariant and exits cleanly.
UPDATES="$(cat)"
if [ -n "$UPDATES" ] && ! printf '%s\n' "$UPDATES" | awk '$3 == "refs/heads/master" { found=1 } END { exit !found }'; then
  exit 0
fi

# A missing checker used to `exit 0` here, which did two wrong things at once:
# it read "the checker is absent" as "the checks passed", and because this sits
# ABOVE the money gate it also took preflight_integrity down with it — two
# independent gates disarmed by one unrelated file's absence. Verified: with
# system_check.py removed and portfolio.json failing its arithmetic, the push
# went through.
#
# A repo carrying portfolio.json is a ledger workspace, so a missing checker
# there is a broken install, not a bootstrap. Say so and refuse. A repo without
# the money file keeps the original permissive behaviour.
if [ ! -f "$WS/ops/system_check.py" ]; then
  if [ -f "$WS/portfolio.json" ]; then
    echo "🚫 push blocked — ops/system_check.py is missing from a workspace"
    echo "   that carries portfolio.json. The book was not verified."
    echo "   Override (rare): git push --no-verify"
    exit 1
  fi
  # No money file and no checker — not a ledger workspace, let push through.
  exit 0
fi

echo "▸ running clawock system_check.py before push…"
# NOTE: `set -e` above means a non-zero exit here would abort the hook BEFORE we
# inspect RC — which is exactly what we must NOT do for RC=2 (warnings, allow).
# So capture the rc without letting set -e kill us. Warning-only checks use RC=2
# and must never become a generic "failed to push some refs" error.
RC=0
python3 "$WS/ops/system_check.py" || RC=$?

# RC=0 all OK, RC=2 warnings only (must not block). ANY other code means the
# checker did not deliver a verdict — interpreter missing (127), killed (137),
# interrupted (130), unhandled traceback (1 is already blocked). Blocking only
# RC=1 left every one of those as a silent pass, which is the same fail-open the
# scan itself was just fixed for: a security gate that cannot run must not
# certify. Override stays available via --no-verify.
if [ "$RC" != "0" ] && [ "$RC" != "2" ]; then
  echo
  if [ "$RC" = "1" ]; then
    echo "🚫 push blocked by clawock system_check (critical failures above)"
  else
    echo "🚫 push blocked — clawock system_check did not complete (exit $RC)"
    echo "   it produced no verdict, so nothing here is certified clean"
  fi
  echo "   fix the issue, OR override with: git push --no-verify"
  exit 1
fi

# ── Money-conservation gate (2026-07-04) ─────────────────────────────────────
# preflight_integrity's ERROR class = arithmetic identities that MUST hold:
# TCV==Σcurrent_value, total_pnl==TCV−cost, cash==baseline+Σtrades+adj (CASH_RECON),
# cost_basis==moving-weighted (COST_BASIS), FX currency tags. These fire exactly
# when someone edited portfolio.json (a T+0 sell, an abshou buy) and FORGOT to
# reconcile — the "$581 double-count" / "phantom-peak TCV" class of bug. Turning
# the human "改完必跑 recompute" 铁律 into a structural block: never publish an
# unreconciled book. WARN (staleness etc.) does NOT block. Override: --no-verify.
IRC=0
if ! command -v clawock >/dev/null 2>&1; then
  echo "🚫 push blocked — clawock CLI is missing; the money checker cannot run"
  echo "   install the current package before publishing this ledger"
  exit 1
fi
CLAWOCK_WORKSPACE="$WS" clawock integrity >/tmp/clawock_integrity.out 2>&1 || IRC=$?
# Same rule as above: 0 = clean, 2 = ERROR findings, anything else = the checker
# never reached a verdict and must not be read as a pass.
if [ "$IRC" != "0" ]; then
  echo
  if [ "$IRC" = "2" ]; then
    echo "🚫 push blocked — portfolio.json fails a money-conservation check:"
    grep -E 'ERROR|❌|🔴' /tmp/clawock_integrity.out | head -12
    echo "   run:  clawock reconcile   (recompute derivations, then re-check)"
    echo "   then re-commit portfolio.json. Override (rare): git push --no-verify"
  else
    echo "🚫 push blocked — clawock integrity did not complete (exit $IRC):"
    tail -12 /tmp/clawock_integrity.out
    echo "   the book was not verified. Override (rare): git push --no-verify"
  fi
  exit 1
fi

# RC=0 (all OK) or RC=2 (warnings) — allow push
exit 0
