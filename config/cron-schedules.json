{
  "schema_version": 2,
  "description": "Single tracked contract for live OpenClaw schedules, watchdog schedules, and payload semantics. Seasonal US schedules are derived from America/New_York DST; runtime truth is checked through the OpenClaw CLI and crontab.",
  "timezone": "Asia/Hong_Kong",
  "dst_sync": {
    "schedule": {
      "kind": "cron",
      "expr": "20 6 * * *",
      "tz": "Asia/Hong_Kong"
    },
    "command_contains": [
      "scripts/data/sync_us_cron_dst.py",
      "--apply"
    ]
  },
  "payload_profiles": {
    "report": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "delivery_mode": "none",
      "required_substrings": [
        "skills/{skill}/SKILL.md",
        "report_preflight.py --market {market} --phase {phase}",
        "context_id",
        "report_postflight.py --market {market} --phase {phase} --context-id",
        "--text-file",
        "report-prose-{market}-{phase}.md",
        "目标 ≤ 2200 字",
        ">3000 字 warn",
        ">3500 字 fail",
        "唯一微信路径",
        "同步 Telegram",
        "禁用 message",
        "--no-deliver"
      ],
      "forbidden_substrings": [
        "≤ 800",
        "≤800",
        "≤ 600",
        "≤600",
        "目标 ≤ 1200 字",
        ">2000 字 warn",
        ">2500 字 fail",
        "唯一发送路径",
        "report-context-",
        "verbatim",
        "trading_calendar.py"
      ]
    },
    "intraday": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "thinking": "medium",
      "delivery_mode": "none",
      "trigger": {
        "script_path": "config/cron-triggers/intraday-{market}.js",
        "once": false
      },
      "required_substrings": [
        "trading_calendar.py {market}",
        "skills/{skill}/SKILL.md",
        "intraday_preflight.py --market {market}",
        "intraday_postflight.py --market {market}",
        "--text-file",
        "intraday-report-{market}.md",
        "intraday-insights-",
        "目标 ≤ 2200 字",
        ">3000 字 warn",
        ">3500 字 fail",
        "唯一微信路径",
        "同步 Telegram",
        "禁用 message",
        "--no-deliver"
      ],
      "forbidden_substrings": [
        "≤ 800",
        "≤800",
        "≤ 600",
        "≤600",
        "目标 ≤ 1200 字",
        ">2000 字 warn",
        ">2500 字 fail",
        "唯一发送路径",
        "<<<"
      ]
    },
    "brief": {
      "timeout_seconds": 1800,
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "delivery_mode": "none",
      "required_substrings": [
        "trading_calendar.py hk",
        "trading_calendar.py us",
        "skills/daily-deep-brief/SKILL.md",
        "brief_preflight.py",
        "brief_postflight.py",
        "唯一微信路径",
        "同步 Telegram",
        "绝不要",
        "message"
      ],
      "forbidden_substrings": [
        "唯一投递路径"
      ]
    },
    "memory": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "delivery_mode": "none",
      "exact_message": "__openclaw_memory_core_short_term_promotion_dream__"
    }
  },
  "jobs": [
    {
      "name": "美股盘中盯盘-overnight",
      "enabled": true,
      "market": "us",
      "mode": "Mode 7",
      "harness": "intraday --us",
      "payload_profile": "intraday",
      "payload_vars": {
        "market": "us",
        "skill": "us-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "*/30 0-2 * * 2-6",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "10,40 0-2 * * 2-6",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "intraday_watchdog.py",
          "--job-name \"美股盘中盯盘-overnight\"",
          "--market us"
        ]
      }
    },
    {
      "name": "Memory Dreaming Promotion",
      "enabled": true,
      "mode": "memory-core",
      "harness": "—",
      "payload_profile": "memory",
      "schedule": {
        "kind": "cron",
        "expr": "0 3 * * *"
      }
    },
    {
      "name": "美股收盘报告",
      "enabled": true,
      "market": "us",
      "phase": "close",
      "mode": "Mode 6",
      "harness": "report --us close",
      "payload_profile": "report",
      "payload_vars": {
        "market": "us",
        "phase": "close",
        "skill": "us-stock-analysis"
      },
      "seasonal_schedules": {
        "daylight": {
          "kind": "cron",
          "expr": "0 4 * * 2-6",
          "tz": "Asia/Shanghai"
        },
        "standard": {
          "kind": "cron",
          "expr": "0 5 * * 2-6",
          "tz": "Asia/Shanghai"
        }
      },
      "watchdog": {
        "seasonal_schedules": {
          "daylight": {
            "kind": "cron",
            "expr": "20 4 * * 2-6",
            "tz": "Asia/Hong_Kong"
          },
          "standard": {
            "kind": "cron",
            "expr": "20 5 * * 2-6",
            "tz": "Asia/Hong_Kong"
          }
        },
        "command_contains": [
          "report_watchdog.py",
          "--market us",
          "--phase close"
        ]
      }
    },
    {
      "name": "盘前深度简报",
      "enabled": true,
      "mode": "daily-deep-brief",
      "harness": "brief_*",
      "payload_profile": "brief",
      "schedule": {
        "kind": "cron",
        "expr": "0 8 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "30 8 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "brief_watchdog.py >>"
        ]
      },
      "extra_watchdogs": [
        {
          "purpose": "miss-detector: brief never written (08:30 is inside the landing window)",
          "schedule": {
            "kind": "cron",
            "expr": "5 9 * * 1-5",
            "tz": "Asia/Hong_Kong"
          },
          "command_contains": [
            "brief_watchdog.py --check-missing"
          ]
        }
      ]
    },
    {
      "name": "港股开盘报告",
      "enabled": true,
      "market": "hk",
      "phase": "open",
      "mode": "Mode 6",
      "harness": "report --hk open",
      "payload_profile": "report",
      "payload_vars": {
        "market": "hk",
        "phase": "open",
        "skill": "hk-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "30 9 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "45 9 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "report_watchdog.py",
          "--market hk",
          "--phase open"
        ]
      }
    },
    {
      "name": "盘中盯盘",
      "enabled": true,
      "market": "hk",
      "mode": "Mode 7",
      "harness": "intraday --hk",
      "payload_profile": "intraday",
      "payload_vars": {
        "market": "hk",
        "skill": "hk-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "*/30 10-11,14-15 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "10,40 10-11,14-15 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "intraday_watchdog.py",
          "--job-name \"盘中盯盘\"",
          "--market hk"
        ]
      }
    },
    {
      "name": "港股午盘报告",
      "enabled": true,
      "market": "hk",
      "phase": "mid",
      "mode": "Mode 6",
      "harness": "report --hk mid",
      "payload_profile": "report",
      "payload_vars": {
        "market": "hk",
        "phase": "mid",
        "skill": "hk-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "0 12 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "12 12 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "report_watchdog.py",
          "--market hk",
          "--phase mid"
        ]
      }
    },
    {
      "name": "港股午后快报",
      "enabled": true,
      "market": "hk",
      "phase": "pm",
      "mode": "Mode 6",
      "harness": "report --hk pm",
      "payload_profile": "report",
      "payload_vars": {
        "market": "hk",
        "phase": "pm",
        "skill": "hk-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "30 13 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "42 13 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "report_watchdog.py",
          "--market hk",
          "--phase pm"
        ]
      }
    },
    {
      "name": "港股收盘报告",
      "enabled": true,
      "market": "hk",
      "phase": "close",
      "mode": "Mode 6",
      "harness": "report --hk close",
      "payload_profile": "report",
      "payload_vars": {
        "market": "hk",
        "phase": "close",
        "skill": "hk-stock-analysis"
      },
      "schedule": {
        "kind": "cron",
        "expr": "0 16 * * 1-5",
        "tz": "Asia/Shanghai"
      },
      "watchdog": {
        "schedule": {
          "kind": "cron",
          "expr": "15 16 * * 1-5",
          "tz": "Asia/Hong_Kong"
        },
        "command_contains": [
          "report_watchdog.py",
          "--market hk",
          "--phase close"
        ]
      }
    },
    {
      "name": "美股开盘报告",
      "enabled": true,
      "market": "us",
      "phase": "open",
      "mode": "Mode 6",
      "harness": "report --us open",
      "payload_profile": "report",
      "payload_vars": {
        "market": "us",
        "phase": "open",
        "skill": "us-stock-analysis"
      },
      "seasonal_schedules": {
        "daylight": {
          "kind": "cron",
          "expr": "30 21 * * 1-5",
          "tz": "Asia/Shanghai"
        },
        "standard": {
          "kind": "cron",
          "expr": "30 22 * * 1-5",
          "tz": "Asia/Shanghai"
        }
      },
      "watchdog": {
        "seasonal_schedules": {
          "daylight": {
            "kind": "cron",
            "expr": "45 21 * * 1-5",
            "tz": "Asia/Hong_Kong"
          },
          "standard": {
            "kind": "cron",
            "expr": "45 22 * * 1-5",
            "tz": "Asia/Hong_Kong"
          }
        },
        "command_contains": [
          "report_watchdog.py",
          "--market us",
          "--phase open"
        ]
      }
    },
    {
      "name": "美股盘中盯盘",
      "enabled": true,
      "market": "us",
      "mode": "Mode 7",
      "harness": "intraday --us",
      "payload_profile": "intraday",
      "payload_vars": {
        "market": "us",
        "skill": "us-stock-analysis"
      },
      "seasonal_schedules": {
        "daylight": {
          "kind": "cron",
          "expr": "*/30 22-23 * * 1-5",
          "tz": "Asia/Shanghai"
        },
        "standard": {
          "kind": "cron",
          "expr": "*/30 23 * * 1-5",
          "tz": "Asia/Shanghai"
        }
      },
      "watchdog": {
        "seasonal_schedules": {
          "daylight": {
            "kind": "cron",
            "expr": "10,40 22-23 * * 1-5",
            "tz": "Asia/Hong_Kong"
          },
          "standard": {
            "kind": "cron",
            "expr": "10,40 23 * * 1-5",
            "tz": "Asia/Hong_Kong"
          }
        },
        "command_contains": [
          "intraday_watchdog.py",
          "--job-name \"美股盘中盯盘\"",
          "--market us"
        ]
      }
    }
  ]
}
