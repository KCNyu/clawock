{
  "schema_version": 2,
  "description": "Single tracked contract for live OpenClaw schedules, watchdog schedules, and payload semantics. Seasonal US schedules are derived from America/New_York DST; runtime truth is checked through the OpenClaw CLI and crontab.",
  "timezone": "Asia/Hong_Kong",
  "dst_sync": {
    "schedule": {
      "kind": "cron",
      "expr": "20 6 * * *",
      "tz": "Asia/Hong_Kong"
    },
    "command": "/usr/bin/python3 /root/.openclaw/workspace/ops/host/sync_us_cron_dst.py --apply >> /root/.openclaw/workspace/logs/dst-sync.log 2>&1",
    "legacy_command_contains": [
      ["scripts/data/sync_us_cron_dst.py", "--apply"]
    ]
  },
  "payload_profiles": {
    "report": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "fallbacks": [
        "minimax-2/MiniMax-M3"
      ],
      "thinking": "adaptive",
      "message_template": "config/cron-payloads/report.md",
      "delivery_mode": "none",
      "required_substrings": [
        "skills/{skill}/SKILL.md",
        "并行调用 `read` 读取 `/root/.openclaw/workspace/skills/{skill}/SKILL.md` 与 Step 1 preflight",
        "skills catalog 只有索引，不含 SKILL.md 正文",
        "clawock report preflight --market {market} --phase {phase}",
        "context_id",
        "clawock report postflight --market {market} --phase {phase} --context-id",
        "--text-file",
        "report-prose-{market}-{phase}.md",
        ">5000 warn",
        ">6000 fail",
        "唯一微信路径",
        "同步 Telegram",
        "禁用 message",
        "--no-deliver"
      ],
      "forbidden_substrings": [
        "≤ 800",
        "≤800",
        "≤ 600",
        "≤600",
        "目标 ≤ 1200 字",
        ">2000 字 warn",
        ">2500 字 fail",
        "唯一发送路径",
        "report-context-",
        "verbatim",
        "trading_calendar.py",
        "目标 ≤ 2200 字",
        ">3000 字 warn",
        ">3500 字 fail"
      ]
    },
    "intraday": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "fallbacks": [
        "minimax-2/MiniMax-M3"
      ],
      "thinking": "adaptive",
      "message_template": "config/cron-payloads/intraday.md",
      "tools_allow": null,
      "delivery_mode": "none",
      "required_substrings": [
        "skills/{skill}/SKILL.md",
        "并行调用 `read` 读取 `/root/.openclaw/workspace/skills/{skill}/SKILL.md` 与 Step 1 preflight",
        "skills catalog 只有索引，不含 SKILL.md 正文",
        "clawock intraday preflight --market {market}",
        "market_closed",
        "所有脚本 exec 调用都显式设置 `timeout: 300`",
        "若 exec 返回 `Command still running`，只用 `process` poll 对应 session；禁止新开 exec 用 sleep/ps/ls/grep 探测进度",
        "context_id",
        "同一条回复内并行发出两个 `write` 工具调用",
        "数字必须原样照抄 context 的完整字面值；禁止四舍五入、取整或改写成“约/近”等近似数，找不到原值就省略",
        "clawock intraday postflight --market {market} --context-id",
        "--text-file",
        "intraday-prose-{market}.md",
        "intraday-insights-",
        ">5000 warn",
        ">6000 fail",
        "唯一微信路径",
        "同步 Telegram",
        "禁用 message",
        "postflight 返回 pass/warn 后直接输出其 `wechat_prefix` + 散文并结束；禁止再读、搜或重建临时文件来确认送达",
        "--no-deliver"
      ],
      "forbidden_substrings": [
        "≤ 800",
        "≤800",
        "≤ 600",
        "≤600",
        "目标 ≤ 1200 字",
        ">2000 字 warn",
        ">2500 字 fail",
        "唯一发送路径",
        "<<<",
        "verbatim",
        "intraday-report-",
        "trading_calendar.py",
        "目标 ≤ 2200 字",
        ">3000 字 warn",
        ">3500 字 fail"
      ]
    },
    "brief": {
      "timeout_seconds": 1800,
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "model_candidates": [
        "minimax/MiniMax-M3",
        "minimax-2/MiniMax-M3",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-4-6"
      ],
      "fallbacks": [
        "minimax-2/MiniMax-M3"
      ],
      "thinking": "adaptive",
      "message_template": "config/cron-payloads/brief.md",
      "delivery_mode": "none",
      "required_substrings": [
        "trading_calendar.py hk",
        "trading_calendar.py us",
        "skills/daily-deep-brief/SKILL.md",
        "并行调用 `read` 读取 `/root/.openclaw/workspace/skills/daily-deep-brief/SKILL.md` 与下方 Step 0 的两个休市闸命令",
        "skills catalog 只有索引，不含 SKILL.md 正文",
        "clawock brief preflight",
        "clawock brief postflight",
        "首次生成和 postflight 修复 Step 4 产物都只用 `write` 完整覆盖；禁止 `edit` 精确文本替换",
        "唯一微信路径",
        "同步 Telegram",
        "绝不要",
        "message"
      ],
      "forbidden_substrings": [
        "唯一投递路径"
      ]
    },
    "memory": {
      "payload_kind": "agentTurn",
      "model": "minimax/MiniMax-M3",
      "fallbacks": [],
      "delivery_mode": "none",
      "exact_message": "__openclaw_memory_core_short_term_promotion_dream__"
    }
  },
  "jobs": [
    {
      "name": "美股盘中盯盘-overnight",
      "enabled": true,
      "market": "us",
      "mode": "Mode 7",
