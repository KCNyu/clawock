{
  "schema_version": 1,
  "registered_at": "2026-10-12",
  "purpose": "Two compositions of strategy plugins. `live` is what the brief, report and intraday paths compute with: each row provides a service those paths read. `plugins` is the research composition strategy-lab mounts: a row there registers parameters and a search space, never grants live permission, and a retrospective optimisation only ever produces a proposal.",
  "live": [
    {"id": "factors", "module": "clawock.strategies.plugins.quant_factors", "config": {"sigma_target": 0.25}, "signal_source": true},
    {"id": "daily-bars", "module": "clawock.strategies.plugins.daily_bars", "config": {"adjustment": "qfq"}},
    {"id": "add-policy", "module": "clawock.strategies.plugins.add_policy"},
    {"id": "add-alpha", "module": "clawock.strategies.plugins.add_alpha"},
    {"id": "left-side", "module": "clawock.strategies.plugins.left_side"},
    {"id": "add-side", "module": "clawock.strategies.plugins.add_side"},
    {"id": "preposition", "module": "clawock.strategies.plugins.preposition"},
    {"id": "intraday-policy", "module": "clawock.strategies.plugins.intraday_policy"},
    {"id": "bar-signals", "module": "clawock.strategies.plugins.bar_signals", "signal_source": true},
    {"id": "signal-panel", "module": "clawock.strategy_lab.plugins.signal_panel"},
    {"id": "sentiment", "module": "clawock.strategies.plugins.sentiment", "config": {"stale_after_hours": 36}, "signal_source": true},
    {"id": "strategy-scores", "module": "clawock.strategy_lab.plugins.strategy_scores", "signal_source": true}
  ],
  "plugins": [
    {"id": "strategies", "module": "clawock.strategies.registry"},
    {"id": "factors", "module": "clawock.strategies.plugins.quant_factors", "config": {"sigma_target": 0.25}},
    {"id": "bars", "module": "clawock.strategy_lab.plugins.adjusted_bars", "config": {"sessions": 800}},
    {"id": "costs", "module": "clawock.strategy_lab.plugins.registered_costs"},
    {
      "id": "promoter",
      "module": "clawock.strategy_lab.plugins.row_edits",
      "config": {"min_prospective_sessions": 60, "prospective_ic_ci95_lower_gt": 0.0}
    },
    {
      "id": "rsi",
      "module": "clawock.strategies.plugins.rsi",
      "signal_source": true,
      "config": {
        "params": {"period": 14, "direction": "reversion"},
        "space": {"period": [5, 7, 9, 14, 21, 28], "direction": ["momentum", "reversion"]}
      }
    },
    {
      "id": "optimizer",
      "module": "clawock.strategy_lab.plugins.walkforward",
      "config": {
        "horizon_sessions": 5,
        "min_cross_section": 6,
        "min_train_sessions": 60,
        "test_sessions": 20,
        "pbo_groups": 8,
        "gate": {
          "min_oos_sessions": 60,
          "oos_ic_ci95_lower_gt": 0.0,
          "oos_lift_ci95_lower_gt": 0.0,
          "pbo_lt": 0.5,
          "corporate_actions_adjusted": true
        },
        "gate_alternates": [
          {
            "id": "statistics-only",
            "rationale": "A bars source that cannot say it is adjusted — memory/bars, or the adjusted source on a day the provider answers raw — is refused by the registered gate whatever the statistics say. This alternate drops only that check, to keep on record what the statistics alone would have concluded.",
            "gate": {"corporate_actions_adjusted": false}
          },
          {
            "id": "net-of-cost",
            "effect": "live",
            "rationale": "The registered gate reads a gross rank IC. This alternate adds one check: the better-half basket's excess over the equal-weight of all names, after the registered cost model, must have a bootstrap interval above zero. It has live effect: a candidate it would refuse is not cleared for prospective registration.",
            "gate": {"oos_net_excess_ci95_lower_gt": 0.0}
          }
        ]
      }
    }
  ]
}
